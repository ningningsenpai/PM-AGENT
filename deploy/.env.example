# 默认仅允许 Docker 主机访问；远程中间件主机改为其 ZeroTier IP
MIDDLEWARE_BIND_ADDRESS=127.0.0.1

MYSQL_ROOT_PASSWORD=pm_agent_root
MYSQL_DATABASE=pm_agent
MYSQL_USER=pm_agent
MYSQL_PASSWORD=pm_agent_dev
MYSQL_PORT=3306

REDIS_PORT=6379
