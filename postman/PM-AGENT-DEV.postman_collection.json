          "const traceId = pm.variables.replaceIn(\"{{$guid}}\");\r",
          "const userId = pm.collectionVariables.get(\"x_user_id\") || \"dev-user-001\";\r",
          "const tenantId = pm.collectionVariables.get(\"x_tenant_id\") || \"dev-tenant-001\";\r",
          "\r",
          "pm.request.headers.upsert({ key: \"X-Trace-Id\", value: traceId });\r",
          "pm.request.headers.upsert({ key: \"X-User-Id\", value: userId });\r",
          "pm.request.headers.upsert({ key: \"X-Tenant-Id\", value: tenantId });\r",
