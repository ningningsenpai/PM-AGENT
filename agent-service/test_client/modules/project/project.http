### 创建项目
# 创建成功后，将响应中的 data.id 手动更新到 dev.projectId。
# @name createProject
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json
X-Trace-Id: http-project-create-{{$uuid}}

{
  "projectName": "{{projectName}}"
}

### 查询当前用户项目列表
# @name listProjects
GET {{baseUrl}}/api/v1/projects
Authorization: Bearer {{accessToken}}
X-Trace-Id: http-project-list-{{$uuid}}

### 查询项目详情
# @name getProject
GET {{baseUrl}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{accessToken}}
X-Trace-Id: http-project-detail-{{$uuid}}

### 未登录查询项目详情
# @name getProjectWithoutToken
GET {{baseUrl}}/api/v1/projects/{{projectId}}
X-Trace-Id: http-project-unauthorized-{{$uuid}}

### 删除项目——必须在文件清理完成后最后执行
# @name deleteProject
DELETE {{baseUrl}}/api/v1/projects/{{projectId2}}
Authorization: Bearer {{accessToken}}
X-Trace-Id: http-project-delete-{{$uuid}}
