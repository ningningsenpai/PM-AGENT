### 初始化项目文件分析
# 前置条件：已创建项目并上传或覆盖文件，且尚未执行删除文件请求。
# @name initializeProjectFileAnalysis
POST {{baseUrl}}/api/v1/projects/{{projectId}}/files/parse/init
Authorization: Bearer {{accessToken}}
X-Trace-Id: http-file-analysis-{{$uuid}}

> {%
client.test("项目文件分析初始化成功", function () {
    client.assert(response.status === 200, "文件分析 HTTP 状态应为 200");
    client.assert(response.body.code === 200, "文件分析业务状态应为成功");
    client.assert(response.body.traceId, "响应应包含 traceId");
});
%}

### 查询分析后的文件投影
# 同时刷新删除文件请求需要使用的 lockVersion。
# @name listAnalyzedProjectFiles
GET {{baseUrl}}/api/v1/projects/{{projectId}}/files?businessCode=project
Authorization: Bearer {{accessToken}}
X-Trace-Id: http-file-analysis-result-{{$uuid}}

> {%
client.test("分析结果已投影到文件记录", function () {
    client.assert(response.status === 200, "文件列表 HTTP 状态应为 200");
    const currentFile = response.body.data.find(function (item) {
        return String(item.id) === client.global.get("fileId");
    });
    client.assert(currentFile, "文件列表中应包含当前文件");
    client.assert(currentFile.parseAttempts >= 1, "文件解析次数应至少为 1");
});
const currentFile = response.body.data.find(function (item) {
    return String(item.id) === client.global.get("fileId");
});
if (currentFile) {
    client.global.set("fileLockVersion", String(currentFile.lockVersion));
}
%}

### 未登录初始化文件分析
# @name initializeProjectFileAnalysisWithoutToken
POST {{baseUrl}}/api/v1/projects/{{projectId}}/files/parse/init
X-Trace-Id: http-file-analysis-unauthorized-{{$uuid}}

> {%
client.test("未登录文件分析被拒绝", function () {
    client.assert(response.body.code !== 200, "未登录不应启动文件分析");
});
%}
