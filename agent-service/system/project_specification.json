  "project_specification": {
    "development_stage": {
      "current_stage": "阶段一基础档案已完成，整体约 50%",
      "stage_goal": "以固定测试样本验证 PM-Agent 对项目扫描、进度判断、风险识别和后续规划的准确性。",
      "completed": [
        "已完成学生列表、姓名查询、详情和新增的前后端链路",
        "已完成 H2 自动建表与三条演示数据初始化",
        "已提供 MySQL 8 独立建表脚本",
        "已提供四条 MockMvc 关键接口测试用例",
        "已完成 React 单页列表、搜索、详情抽屉和新增表单"
      ],
      "next_focus": [
        "优先修复明文凭据和姓名查询 SQL 注入严重风险",
        "补充鉴权、权限、幂等和个人信息脱敏",
        "实现编辑、逻辑删除与分页",
        "补充班级、课程和成绩能力",
        "增加前端交互、安全与端到端测试"
      ]
    },
