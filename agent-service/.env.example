# DeepSeek API Key；为空时自动进入本地 Demo 模式，不真实调用模型
DEEPSEEK_API_KEY=

# DeepSeek V4-pro 模型名；如供应商实际模型 ID 不同，只改这里
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agent 服务端口
AGENT_HOST=127.0.0.1
AGENT_PORT=8001

# Java 后端地址；本 Demo 只预留，不真实调用 Java
JAVA_BACKEND_BASE_URL=http://localhost:8080
