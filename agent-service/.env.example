# 默认 LLM 提供方；可选：deepseek / doubao / glm / kimi / minimax
DEFAULT_LLM_PROVIDER=deepseek

# ---------------- DeepSeek ----------------
# DeepSeek API Key；选用 deepseek 时必填
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 上下文窗口与输出预留；窗口缺省为空表示暂不做窗口上限判断
DEEPSEEK_CONTEXT_WINDOW_TOKENS=126000
DEEPSEEK_RESERVED_OUTPUT_TOKENS=4096

# ---------------- 豆包（火山方舟） ----------------
# 选用 doubao 时必填；DOUBAO_MODEL 填方舟创建的 endpoint id
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_MODEL=Doubao-Seed-2.0-pro

DOUBAO_EMBEDDING_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_API_KEY=
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision
QDRANT_URL=http://10.144.48.123:6333
QDRANT_COLLECTION=pm_agent_rag_eval_v1

# ---------------- 智谱 GLM ----------------
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# ---------------- Moonshot Kimi ----------------
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---------------- MiniMax ----------------
# MiniMax 部分接口需要 group_id，按官方控制台获取
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=

# Agent 服务端口
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# ---------------- 在线业务基础设施 ----------------
PM_AGENT_DATABASE_URL=mysql+asyncmy://pm-agent:123456-pm-agent@10.144.48.123:3306/pm_agent?charset=utf8mb4
PM_AGENT_DATABASE_ECHO=false
PM_AGENT_DATABASE_POOL_SIZE=5
PM_AGENT_DATABASE_MAX_OVERFLOW=10
PM_AGENT_REDIS_URL=redis://:pm-agent-dev@10.144.48.123:6379/1
PM_AGENT_REDIS_KEY_PREFIX=pm-agent
PM_AGENT_JWT_SECRET=请替换为至少32位的随机字符串
PM_AGENT_JWT_ALGORITHM=HS256
PM_AGENT_TOKEN_TTL_SECONDS=2592000

MINIO_ENDPOINT=10.144.48.123:9000
MINIO_ROOT_USER=pm-agent
MINIO_ROOT_PASSWORD=123456-pm-agent
MINIO_SECURE=false
MINIO_BUCKET=pm-agent
MINIO_READ_URL_EXPIRY_SECONDS=300
PM_AGENT_MAX_UPLOAD_FILE_SIZE_BYTES=52428800

# ---------------- 文件详情解析 ----------------
PM_AGENT_FILE_DETAIL_LLM_ENABLED=false
PM_AGENT_FILE_DETAIL_REQUEST_TIMEOUT_SECONDS=30
PM_AGENT_FILE_DETAIL_MAX_SOURCE_BYTES=52428800
