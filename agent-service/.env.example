# 默认 LLM 提供方；可选：deepseek / doubao / qwen
DEFAULT_LLM_PROVIDER=deepseek

# ---------------- DeepSeek ----------------
# DeepSeek API Key；选用 deepseek 时必填
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=180
# 本地上下文预算；与单次生成的输出上限分别配置
DEEPSEEK_CONTEXT_WINDOW_TOKENS=131072
# 普通聊天的上下文预算预留；文件解析使用下方独立输出额度
DEEPSEEK_RESERVED_OUTPUT_TOKENS=16384

# ---------------- 豆包（火山方舟） ----------------
# 选用 doubao 时必填；DOUBAO_MODEL 填方舟创建的 endpoint id
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_MODEL=Doubao-Seed-2.0-pro

DOUBAO_EMBEDDING_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_API_KEY=
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision
QDRANT_URL=http://10.144.48.123:6333
QDRANT_COLLECTION=pm_agent_rag_eval_v1

# ---------------- 智谱 GLM ----------------
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# ---------------- Moonshot Kimi ----------------
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---------------- MiniMax ----------------
# MiniMax 部分接口需要 group_id，按官方控制台获取
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=

# Agent 服务端口
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# ---------------- 在线业务基础设施 ----------------
PM_AGENT_DATABASE_URL=mysql+asyncmy://pm_agent:pm_agent_dev@127.0.0.1:3306/pm_agent?charset=utf8mb4
PM_AGENT_DATABASE_ECHO=false
PM_AGENT_DATABASE_POOL_SIZE=5
PM_AGENT_DATABASE_MAX_OVERFLOW=10
PM_AGENT_REDIS_URL=redis://:pm-agent-dev@127.0.0.1:6379/1
PM_AGENT_REDIS_KEY_PREFIX=pm-agent
PM_AGENT_JWT_SECRET=请替换为至少32位的随机字符串
PM_AGENT_JWT_ALGORITHM=HS256
PM_AGENT_TOKEN_TTL_SECONDS=2592000
# 每个并行运行的后端实例必须配置不同节点编号，取值范围 0～1023
PM_AGENT_SNOWFLAKE_NODE_ID=0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=pm-agent
MINIO_ROOT_PASSWORD=123456-pm-agent
MINIO_SECURE=false
MINIO_BUCKET=pm-agent
MINIO_READ_URL_EXPIRY_SECONDS=300
PM_AGENT_MAX_UPLOAD_FILE_SIZE_BYTES=52428800

# ---------------- 文件详情与项目规范解析 ----------------
# 启用后，受支持项目文件的解析文本会发送到 DeepSeek API
PM_AGENT_FILE_DETAIL_LLM_ENABLED=false
PM_AGENT_FILE_DETAIL_LLM_PROVIDER=deepseek
PM_AGENT_FILE_DETAIL_REQUEST_TIMEOUT_SECONDS=180
# 文件详情与项目规范 JSON 生成共用的输出上限；已知 DeepSeek V4 最大为 384000
PM_AGENT_FILE_DETAIL_MAX_OUTPUT_TOKENS=24576
# 限制解析后送入模型的 UTF-8 文本；超限文件记录失败且不会调用模型
PM_AGENT_FILE_DETAIL_MAX_SOURCE_BYTES=262144
PM_AGENT_CHAT_MAX_OUTPUT_TOKENS=16384
PM_AGENT_MEMORY_MAX_OUTPUT_TOKENS=8192
PM_AGENT_REPORT_MAX_OUTPUT_TOKENS=16384
