# 默认 LLM 提供方；可选：deepseek / doubao / glm / kimi / minimax
DEFAULT_LLM_PROVIDER=deepseek

# ---------------- DeepSeek ----------------
# DeepSeek API Key；选用 deepseek 时必填
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 上下文窗口与输出预留；窗口缺省为空表示暂不做窗口上限判断
DEEPSEEK_CONTEXT_WINDOW_TOKENS=126000
DEEPSEEK_RESERVED_OUTPUT_TOKENS=4096

# ---------------- 豆包（火山方舟） ----------------
# 选用 doubao 时必填；DOUBAO_MODEL 填方舟创建的 endpoint id
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_MODEL=Doubao-Seed-2.0-pro

DOUBAO_EMBEDDING_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_API_KEY=
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision

# ---------------- 智谱 GLM ----------------
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# ---------------- Moonshot Kimi ----------------
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---------------- MiniMax ----------------
# MiniMax 部分接口需要 group_id，按官方控制台获取
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=

# Agent 服务端口
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# ---------------- 文件详情异步解析 ----------------
PM_AGENT_FILE_DETAIL_CONSUMER_ENABLED=false
PM_AGENT_FILE_DETAIL_LLM_ENABLED=false
PM_AGENT_INTERNAL_SERVICE_TOKEN=pm-agent-dev-internal-token
PM_AGENT_RABBITMQ_HOST=127.0.0.1
PM_AGENT_RABBITMQ_PORT=5672
PM_AGENT_RABBITMQ_USERNAME=pm-agent
PM_AGENT_RABBITMQ_PASSWORD=pm-agent-dev
PM_AGENT_RABBITMQ_VHOST=pm-agent
PM_AGENT_FILE_DETAIL_PREFETCH_COUNT=4
PM_AGENT_FILE_DETAIL_MAX_SOURCE_BYTES=52428800
